# Used by `npm run dev:emulator`: points the site at the local Firebase
# emulators (see emulator/README.md). Nothing here is secret.
VITE_USE_EMULATORS=true
VITE_APIKEY=demo-api-key
VITE_AUTHDOMAIN=demo-maneeley.firebaseapp.com
VITE_PROJECTID=demo-maneeley
VITE_STORAGEBUCKET=demo-maneeley.appspot.com
VITE_MESSAGINGSENDERID=0
VITE_APPID=demo-app
# Cloudflare's always-pass test key, so the dashboard's captcha works locally.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
